#    May you find forgiveness for yourself and forgive others.
#    May you share freely, never taking more than you give.
#
#***********************************************************************
# Tests for the matchertext literal M'(value)' and the scanner behind it.
#
# The file is organized by layer, because a failure means something different
# at each one:
#
#   matchertext-1  the scanner, VERIFY and FINDEMBEDEND called directly
#   matchertext-2  the tokenizer, where a literal begins and ends
#   matchertext-3  the parser, which positions accept the new terminal
#   matchertext-4  the value, delivered verbatim as data
#   matchertext-5  backward compatibility, text that parsed before
#
# The scanner tests come from a cross-language suite that checks the same C
# code against an independent Go implementation.  That comparison stays where
# it is, since it needs the other implementation; what moved here are the
# cases whose expected answers are written out by hand and belong beside the
# code they describe.
#
# Everything requires SQLITE_ENABLE_MATCHERTEXT.  Without it there is no
# literal, no scanner, and no test commands, so the file skips itself.

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix matchertext

ifcapable !matchertext {
finish_test
  return
}

#-------------------------------------------------------------------------
# 1.*: The scanner on its own.
#
# VERIFY decides membership in the matchertext language.  It has no SQL
# surface, since it belongs to the write path where a caller checks a value
# before placing it in a hole, so these go through the test command.

# 1.1: valid matchertext
foreach {tn val} {
  1  {}
  2  {hello world}
  3  {(a)}
  4  {[a]}
  5  {{a}}
  6  {((a))}
  7  {([{}])}
  8  {a(b)c[d]e{f}g}
  9  {()[]{}}
} {
  do_test 1.1.$tn { sqlite3_matchertext_verify $val } 1
}

# 1.2: angle brackets are not matchers, so they constrain nothing.  They are
# used unmatched as inequality operators far too often to include.
do_test 1.2.1 { sqlite3_matchertext_verify {a < b > c} } 1
do_test 1.2.2 { sqlite3_matchertext_verify {a > b < c} } 1

# 1.3: the payloads that motivate the exercise carry no matchers at all, so
# they are ordinary matchertext.  Nothing about them is treated as special.
do_test 1.3.1 { sqlite3_matchertext_verify {' OR '1'='1} } 1
do_test 1.3.2 { sqlite3_matchertext_verify {x' OR 1=1 --} } 1
do_test 1.3.3 { sqlite3_matchertext_verify {'; DROP TABLE users; --} } 1
do_test 1.3.4 { sqlite3_matchertext_verify {<script>alert(1)</script>} } 1

# 1.4: unmatched matchers, in either direction
foreach {tn val} {
  1  {(}
  2  {)}
  3  {)(}
  4  {a)b}
  5  {f(x}
  6  {smile :]}
} {
  do_test 1.4.$tn { sqlite3_matchertext_verify $val } 0
}

# 1.5: paired, but with a closer of the wrong kind
do_test 1.5.1 { sqlite3_matchertext_verify {(]} } 0
do_test 1.5.2 { sqlite3_matchertext_verify {([)]} } 0
do_test 1.5.3 { sqlite3_matchertext_verify {([a)]} } 0

# 1.6: an LDAP filter breakout is rejected rather than embedded, which is the
# other of the two ways containment can happen
do_test 1.6.1 { sqlite3_matchertext_verify {*)(uid=*} } 0

# 1.7: zero bytes are ordinary nonmatchers.  VERIFY takes an explicit length
# for exactly this reason.
do_test 1.7.1 {
  sqlite3_matchertext_verify [binary format a1a1a3 "a" "\x00" "(b)"]
} 1
do_test 1.7.2 {
  sqlite3_matchertext_verify [binary format a1a1a2 "a" "\x00" "(b"]
} 0

# 1.8: multi-byte UTF-8 is scanned safely, because every byte of a multi-byte
# sequence is at or above 0x80 and no matcher is
do_test 1.8.1 { sqlite3_matchertext_verify "caf\xc3\xa9 (na\xc3\xafve)" } 1
do_test 1.8.2 { sqlite3_matchertext_verify "caf\xc3\xa9 (na\xc3\xafve" } 0

# 1.9: U+FF3B FULLWIDTH LEFT SQUARE BRACKET is not an ASCII matcher and so
# passes.  It normalizes to a lone "[" under NFKC.  The caller must therefore
# present the value already canonicalized; this records the boundary of what
# the scanner can be responsible for.
do_test 1.9.1 { sqlite3_matchertext_verify "\xef\xbc\xbb" } 1

# 1.10: FINDEMBEDEND locates the closer by balance.  The result counts both
# delimiters, so the value is the result minus two.
foreach {tn text res} {
  1   {()}              2
  2   {(a)}             3
  3   {((a))}           5
  4   {[a]}             3
  5   {{a}}             3
  6   {([{}])}          6
  7   {(a)bcd}          3
  8   {(a)'}            3
} {
  do_test 1.10.$tn { sqlite3_matchertext_end $text } $res
}

# 1.11: the value may hold anything at all, including the host's own
# terminators, because the end is found by balance and not by scanning
do_test 1.11.1 { sqlite3_matchertext_end {(' OR '1'='1)} } 13
do_test 1.11.2 { sqlite3_matchertext_end {('; DROP TABLE t; --)} } 21

# 1.12: the first closer not matched from within ends the embedding, so a
# later one lies outside it
do_test 1.12.1 { sqlite3_matchertext_end {(a)b)} } 3

# 1.13: rejections.  Each fails closed: no embedding ends here.
#
# Written with quoted strings rather than braces, because several of these
# values carry an unmatched brace and so cannot be brace quoted in TCL.
foreach {tn text} [list \
  1  "(a]b)"   \
  2  "(\}"     \
  3  "(abc"    \
  4  "(a(b"    \
  5  "(\[)\]"  \
  6  "("       \
  7  "abc"     \
  8  ")a("     \
  9  ""        \
] {
  do_test 1.13.$tn { sqlite3_matchertext_end $text } 0
}

# 1.14: the depth limit.  Input nested more deeply is rejected rather than
# truncated or accepted, so the failure stays closed.
#
# The budget is spent on the region actually scanned.  VERIFY sees the whole
# string and counts every level.  FINDEMBEDEND begins one byte past the
# opener, since the caller has already consumed that delimiter, so an
# embedding whose value sits at the limit has total nesting of limit+1.
set MTDEPTH 1000
proc mt_nest {d} { return "[string repeat ( $d][string repeat ) $d]" }

do_test 1.14.1 { sqlite3_matchertext_verify [mt_nest $MTDEPTH] } 1
do_test 1.14.2 { sqlite3_matchertext_verify [mt_nest [expr $MTDEPTH+1]] } 0
do_test 1.14.3 {
  sqlite3_matchertext_end [mt_nest [expr $MTDEPTH+1]]
} [expr 2*($MTDEPTH+1)]
do_test 1.14.4 {
  sqlite3_matchertext_end [mt_nest [expr $MTDEPTH+2]]
} 0

#-------------------------------------------------------------------------
# 2.*: The tokenizer.
#
# A literal is M, a quote, a balanced embedding, and a quote.  What matters is
# where the token ends, since that is the boundary an attacker would have to
# escape.

# 2.1: the literal is one token, and what follows it is separate
do_test 2.1.1 { execsql {SELECT M'(abc)'} } {abc}
do_test 2.1.2 { execsql {SELECT M'(abc)' || 'def'} } {abcdef}
do_test 2.1.3 { execsql {SELECT M'(a)', M'(b)'} } {a b}

# 2.2: the prefix is case insensitive, matching every other keyword
do_test 2.2.1 { execsql {SELECT m'(abc)'} } {abc}
do_test 2.2.2 { execsql {SELECT M'(abc)' = m'(abc)'} } {1}

# 2.3: all three matcher pairs delimit
do_test 2.3.1 { execsql {SELECT M'(abc)'} } {abc}
do_test 2.3.2 { execsql {SELECT M'[abc]'} } {abc}
do_test 2.3.3 { execsql {SELECT M'{abc}'} } {abc}

# 2.4: an empty value is a value
do_test 2.4.1 { execsql {SELECT M'()' = ''} } {1}
do_test 2.4.2 { execsql {SELECT length(M'()')} } {0}

# 2.5: the boundary is matcher balance, not the next quote.  These are the
# cases the whole design exists for: a quote inside the value does not end it.
do_test 2.5.1 { execsql {SELECT M'(' OR '1'='1)'} } [list {' OR '1'='1}]
do_test 2.5.2 { execsql {SELECT M'(it's)'} } {it's}
do_test 2.5.3 { execsql {SELECT M'(--)'} } {--}
do_test 2.5.4 { execsql {SELECT M'(;)'} } [list {;}]
do_test 2.5.5 { execsql {SELECT M'(/* not a comment */)'} } {/* not a comment */}

# 2.6: nesting, to a few levels and across pairs
do_test 2.6.1 { execsql {SELECT M'((a))'} } {(a)}
do_test 2.6.2 { execsql {SELECT M'(a(b(c)d)e)'} } {a(b(c)d)e}
do_test 2.6.3 { execsql {SELECT M'([{}])'} } [list "\[{}\]"]

# 2.7: an ill-formed literal is not a literal.  The tokenizer falls through
# and lexes the M as the identifier it has always been, so these fail the way
# an unknown column does rather than as a new class of error.
foreach {tn sql} {
  1  {SELECT M'(unbalanced'}
  2  {SELECT M'(a]b)'}
  3  {SELECT M'(a)b)'}
  4  {SELECT M'abc'}
} {
  do_catchsql_test 2.7.$tn $sql {1 {no such column: M}}
}

# 2.8: the M must abut the quote.  With a space between them this is the
# old reading, an identifier followed by a string, and not a literal.
do_test 2.8.1 { execsql {SELECT M'(abc)'} } {abc}
do_catchsql_test 2.8.2 {
  SELECT M '(abc)'
} {1 {no such column: M}}

#-------------------------------------------------------------------------
# 3.*: The parser.
#
# The terminal appears in one rule and produces a leaf.  No production reads
# structure out of the value, and the literal is not admitted where a name is
# expected.

# 3.1: a literal is a term, so it composes like any other constant
do_test 3.1.1 { execsql {SELECT M'(a)' || M'(b)'} } {ab}
do_test 3.1.2 { execsql {SELECT upper(M'(abc)')} } {ABC}
do_test 3.1.3 { execsql {SELECT CASE M'(a)' WHEN 'a' THEN 'yes' END} } {yes}
do_test 3.1.4 { execsql {SELECT M'(a)' IN ('a','b')} } {1}
do_test 3.1.5 { execsql {SELECT coalesce(NULL, M'(a)')} } {a}

# 3.2: it is a string, not a number or a name
do_test 3.2.1 { execsql {SELECT typeof(M'(123)')} } {text}
do_test 3.2.2 { execsql {SELECT M'(123)' + 1} } {124}   ;# by affinity, as '123'+1

# 3.3: the terminal is admitted where an identifier is expected, beside the
# STRING that may already stand in for a name.  Which of a name or a value it
# becomes is fixed by grammar position, not by resolution at run time, so the
# value still never contributes syntax.
do_execsql_test 3.3.1 {
  CREATE TABLE M'(t1x)'(x);
  SELECT count(*) FROM M'(t1x)';
} {0}
do_execsql_test 3.3.2 {
  SELECT 1 AS M'(alias)'
} {1}

# 3.4: and it names the table it spells, so an absent one is reported by name
do_catchsql_test 3.4.1 {
  SELECT 1 FROM M'(nosuchtable)'
} {1 {no such table: nosuchtable}}

#-------------------------------------------------------------------------
# 4.*: The value.
#
# What sits between the delimiters is delivered as data.  One decoding pass
# runs over it, for the matchertext escape alphabet only: \\ is a backslash,
# and \o() \c() \o[] \c[] \o{} \c{} are the six matchers, so a value that
# could not embed verbatim can still be written.  SQL's own escaping never
# applies: quotes do not double, and a backslash sequence that does not
# spell one of the seven escapes passes through byte for byte.

do_execsql_test 4.0 {
  CREATE TABLE t1(name TEXT);
  INSERT INTO t1 VALUES('alice'), ('bob');
}

# 4.1: no dequoting.  An ordinary literal collapses a doubled quote; a
# matchertext literal does not, because there is no escaping inside one.
do_test 4.1.1 { execsql {SELECT M'(it''s)'} } {it''s}
do_test 4.1.2 { execsql {SELECT length(M'(it''s)')} } {5}
do_test 4.1.3 { execsql {SELECT 'it''s'} } {it's}
do_test 4.1.4 { execsql {SELECT length('it''s')} } {4}

# 4.2: a backslash that does not introduce an escape is an ordinary byte
do_test 4.2.1 { execsql {SELECT M'(a\nb)'} } [list {a\nb}]

# 4.2.2+: the escape alphabet decodes.  A doubled backslash is one
# backslash, and an escaped matcher is the matcher, which is how a value
# carrying an unmatched matcher is written at all.
do_test 4.2.2 { execsql {SELECT M'(a\\b)'} } [list {a\b}]
do_test 4.2.3 { execsql {SELECT M'(\o())'} } {(}
do_test 4.2.4 { execsql {SELECT M'(smile :\c[])'} } {{smile :]}}
do_test 4.2.5 { execsql {SELECT length(M'(\o{})')} } {1}
# A malformed escape is not an escape: the pair must be real and adjacent
do_test 4.2.6 { execsql {SELECT M'(\o(x))'} } [list {\o(x)}]

# 4.3: the value reaches the database and comes back unchanged
do_test 4.3.1 {
  execsql {
    DELETE FROM t1;
    INSERT INTO t1 VALUES(M'(' OR '1'='1)');
    SELECT name FROM t1;
  }
} [list {' OR '1'='1}]

# 4.4: and it is inert at the sink.  The canonical injection selects nothing,
# because it is compared as data rather than read as syntax.
do_execsql_test 4.4.0 {
  DELETE FROM t1;
  INSERT INTO t1 VALUES('alice'), ('bob');
}
do_test 4.4.1 {
  execsql {SELECT count(*) FROM t1 WHERE name = M'(' OR '1'='1)'}
} {0}
do_test 4.4.2 {
  execsql {SELECT count(*) FROM t1 WHERE name = M'(alice)'}
} {1}

# 4.5: the parse does not depend on what the value contains.  The bytecode of
# the same statement is identical for every payload, apart from the slot that
# holds the string.
#
# mt_skeleton drops the P4 operand, which is the only place the value may
# appear, and compares everything else.
proc mt_skeleton {sql payload} {
  set out [list]
  foreach {addr opcode p1 p2 p3 p4 p5 comment} \
      [execsql [string map [list %V% "M'($payload)'"] $sql]] {
    lappend out $addr $opcode $p1 $p2 $p3 $p5
  }
  return $out
}

set mt_payloads {
  1  {' OR '1'='1}
  2  {x'; DROP TABLE t1; --}
  3  {%_ [] {} ()}
  4  {UNION ALL SELECT * FROM sqlite_schema}
  5  {a'||(SELECT group_concat(name) FROM sqlite_schema)||'b}
  6  {"dq" `bt` [br] {br}}
  7  {}
  8  {/* comment */ -- line}
}

# Four query shapes, so the result does not rest on one statement kind.
set mt_hosts {
  select   {EXPLAIN SELECT * FROM t1 WHERE name = %V%}
  insert   {EXPLAIN INSERT INTO t1(name) VALUES(%V%)}
  like     {EXPLAIN SELECT * FROM t1 WHERE name LIKE %V%}
  ordering {EXPLAIN SELECT %V% AS c FROM t1 ORDER BY 1}
}

foreach {host sql} $mt_hosts {
  set mt_base [mt_skeleton $sql {alice}]
  foreach {tn payload} $mt_payloads {
    do_test 4.5.$host.$tn { mt_skeleton $sql $payload } $mt_base
  }
}

#-------------------------------------------------------------------------
# 6.*: The rewriting paths.
#
# Several places in SQLite take a token out of the SQL text and dequote it,
# collapsing doubled quotes. None may reach a matchertext value, because a
# value legitimately begins with a quote and would be silently rewritten.
#
# The separation is structural rather than lucky. Seven of the eight callers
# of sqlite3Dequote() take their token from a rule in an identifier position,
# nm, ids or typetoken, and MTSTRING appears only in term. The eighth switches
# on TK_ID. The tests below pin that: each drives a value beginning with a
# quote through a path that dequotes an ordinary token, and checks the bytes
# come back whole.

do_execsql_test 6.0 {
  CREATE TABLE t6(a TEXT, b TEXT);
}

# 6.1: a value that begins and ends with a quote survives insertion and
# retrieval untouched.  Under sqlite3Dequote() the leading quote would be read
# as a delimiter and the value would lose characters.
do_test 6.1.1 {
  execsql {
    DELETE FROM t6;
    INSERT INTO t6(a) VALUES(M'('quoted')');
    SELECT a, length(a) FROM t6;
  }
} [list {'quoted'} 8]

# 6.2: doubled quotes stay doubled.  This is the case that separates a
# matchertext value from an ordinary literal, where '' means one quote.
do_test 6.2.1 {
  execsql {SELECT M'(a''b)', length(M'(a''b)')}
} [list {a''b} 4]

# 6.3: through a column alias, which is where sqlite3ExprListSetName() would
# dequote an ordinary token
do_test 6.3.1 {
  execsql {SELECT M'('x')' AS c}
} [list {'x'}]

# 6.4: through a DEFAULT clause, stored in the schema and re-parsed on the
# next open.  This exercises the round trip the L3 claim depends on.
do_test 6.4.1 {
  execsql {
    CREATE TABLE t6b(x TEXT DEFAULT (M'('d')'));
    INSERT INTO t6b DEFAULT VALUES;
    SELECT x FROM t6b;
  }
} [list {'d'}]
do_test 6.4.2 {
  db close
  sqlite3 db test.db
  execsql {
    INSERT INTO t6b DEFAULT VALUES;
    SELECT DISTINCT x FROM t6b;
  }
} [list {'d'}]

# 6.5: through a view, whose text is stored and re-parsed
do_test 6.5.1 {
  execsql {
    CREATE VIEW v6 AS SELECT M'(' OR '1'='1)' AS payload;
    SELECT payload FROM v6;
  }
} [list {' OR '1'='1}]
do_test 6.5.2 {
  db close
  sqlite3 db test.db
  execsql {SELECT payload FROM v6}
} [list {' OR '1'='1}]

# 6.6: normalization.  sqlite3_normalized_sql() exists to be safe to log, so
# every literal must reduce to a question mark.  A matchertext literal that
# fell through to the default branch would be copied out verbatim, and folded
# to upper case on the way, putting an attacker-controlled value into the log.
ifcapable normalize {
  do_test 6.6.1 {
    set stmt [sqlite3_prepare_v2 db {SELECT * FROM t6 WHERE a = M'(secret)'} -1 tail]
    set res [sqlite3_normalized_sql $stmt]
    sqlite3_finalize $stmt
    set res
  } {SELECT*FROM t6 WHERE a=?;}

  # The same statement with an ordinary literal normalizes identically, which
  # is the property worth having: the two literal forms are indistinguishable
  # once the value is gone.
  do_test 6.6.2 {
    set stmt [sqlite3_prepare_v2 db {SELECT * FROM t6 WHERE a = 'secret'} -1 tail]
    set res [sqlite3_normalized_sql $stmt]
    sqlite3_finalize $stmt
    set res
  } {SELECT*FROM t6 WHERE a=?;}
}

#-------------------------------------------------------------------------
# 7.*: The name hole, [...].
#
# SQLite already delimits identifiers with a matcher pair. The only change is
# that the reader ends the name by balance instead of at the first ']', which
# is premise A1 for this position with no new syntax at all.
#
# Strict: an unbalanced interior is an error, not a fall back to the old scan.

# 7.1: ordinary bracketed identifiers are unaffected
do_execsql_test 7.1.1 {
  CREATE TABLE [t7](x);
  INSERT INTO [t7] VALUES(1);
  SELECT x FROM [t7];
} {1}
do_execsql_test 7.1.2 {
  CREATE TABLE [two words](y);
  SELECT count(*) FROM [two words];
} {0}

# 7.2: nesting now works, and the name is exactly the interior
do_execsql_test 7.2.1 {
  CREATE TABLE [a[b]c](z);
  INSERT INTO [a[b]c] VALUES(2);
  SELECT z FROM [a[b]c];
} {2}
do_test 7.2.2 {
  execsql {SELECT name FROM sqlite_schema WHERE name LIKE 'a%c'}
} [list {a[b]c}]
do_execsql_test 7.2.3 {
  CREATE TABLE [x([{}])y](w);
  SELECT count(*) FROM [x([{}])y];
} {0}

# 7.3: the name may hold what a name never could.  The six matcher escapes
# decode in the interior; every other byte, backslash included, is taken
# verbatim.
do_test 7.3.1 {
  execsql {CREATE TABLE [it's ; -- ok](v)}
  execsql {SELECT name FROM sqlite_schema WHERE name LIKE 'it%'}
} [list {it's ; -- ok}]

# 7.4: strict.  An unmatched bracket is an error.
#
# 7.4.1 is the compatibility cost: [a[b] names the column a[b] today and does
# not parse here. 7.4.2 was already an error before the change.
do_catchsql_test 7.4.1 {
  SELECT 1 FROM [a[b]
} {1 {unrecognized token: "[a[b"}}
do_catchsql_test 7.4.2 {
  SELECT 1 FROM [a]b]
} {1 {unrecognized token: "]"}}
do_catchsql_test 7.4.3 {
  SELECT 1 FROM [a)b]
} {1 {unrecognized token: "[a)b"}}

# 7.5: it is a name, not a value.  The two holes stay disjoint: a bracketed
# form resolves as a column reference, never as a string constant.
do_catchsql_test 7.5.1 {
  SELECT [nosuchcolumn]
} {1 {no such column: nosuchcolumn}}

# 7.6: usable wherever a name goes, including an alias and a column reference
do_execsql_test 7.6.1 {
  SELECT z AS [al[ia]s] FROM [a[b]c];
} {2}
do_execsql_test 7.6.2 {
  CREATE TABLE [t7b]([c[0]], [c[1]]);
  INSERT INTO [t7b] VALUES(10, 20);
  SELECT [c[0]] + [c[1]] FROM [t7b];
} {30}

# 7.7: the name survives the schema round trip, which is where a rewriting
# path would show up
do_execsql_test 7.7.1 {
  CREATE VIEW [v[7]] AS SELECT z FROM [a[b]c];
  SELECT z FROM [v[7]];
} {2}
do_test 7.7.2 {
  db close
  sqlite3 db test.db
  execsql {SELECT z FROM [v[7]]}
} {2}

# 7.8: the six matcher escapes decode inside a bracketed name, so a name
# carrying an unmatched matcher can be written into the hole.  Nothing else
# decodes there: a backslash is an ordinary byte in a name, as it always
# was, so [e\\f] names e\\f here exactly as in stock SQLite.
#
# The one spelling whose meaning changes is a name that itself contains a
# valid matcher escape, recorded at 7.8.3 the way 7.4.1 records the
# unbalanced-bracket cost: stock SQLite reads [g\o()h] as the name g\o()h,
# and here it is the name g(h.
do_test 7.8.1 {
  execsql "CREATE TABLE \[e\\\\f\](x); INSERT INTO \[e\\\\f\] VALUES(8)"
  execsql {SELECT name FROM sqlite_schema WHERE name LIKE 'e%f'}
} [list "e\\\\f"]
do_test 7.8.2 {
  execsql "SELECT x FROM \[e\\\\f\]"
} {8}
do_test 7.8.3 {
  execsql "CREATE TABLE \[g\\o()h\](y)"
  execsql {SELECT name FROM sqlite_schema WHERE name LIKE 'g%h'}
} [list {g(h}]
do_test 7.8.4 {
  execsql {SELECT count(*) FROM [g\o()h]}
} {0}
# The decoded name cannot be spelled verbatim, since its bracket is
# unmatched; the escaped spelling is the only one, which is the point of
# having it.
do_catchsql_test 7.8.5 {
  SELECT count(*) FROM [g(h]
} {1 {unrecognized token: "[g(h"}}

#-------------------------------------------------------------------------
# 8.*: L2 against the double-quoted string misfeature.
#
# DQS reinterprets a double-quoted token as a string literal when it fails to
# resolve as an identifier, so one token means a name or a value depending on
# the schema. It stays enabled here, at SQLite's default, because neither hole
# can reach it: resolve.c gates the fallback on EP_DblQuoted, and util.c sets
# that flag only when the token begins with '"'.

do_execsql_test 8.0 {
  CREATE TABLE t8(a);
  INSERT INTO t8 VALUES('zzz');
}

# 8.1: the misfeature is present and on, so what follows is measured against
# the real thing rather than a build with it disabled
do_execsql_test 8.1.1 {
  SELECT "nosuchcolumn"
} {nosuchcolumn}
do_execsql_test 8.1.2 {
  SELECT count(*) FROM t8 WHERE a = "zzz"
} {1}

# 8.2: the value hole is never resolved as a name.  "a" is a real column, so
# DQS is not even needed to make it one; the matchertext form is still a
# string, which is what makes the reading of the hole unconditional.
do_execsql_test 8.2.1 {
  SELECT M'(a)'
} {a}
do_execsql_test 8.2.2 {
  SELECT count(*) FROM t8 WHERE a = M'(zzz)'
} {1}
do_execsql_test 8.2.3 {
  SELECT count(*) FROM t8 WHERE a = M'(a)'
} {0}

# 8.3: the name hole is never reinterpreted as a value.  [...] does not set
# EP_DblQuoted, so an unresolvable bracketed identifier is an error even with
# DQS on, where the double-quoted spelling would have become a string.
do_catchsql_test 8.3.1 {
  SELECT [nosuchcolumn]
} {1 {no such column: nosuchcolumn}}
do_execsql_test 8.3.2 {
  SELECT [a] FROM t8
} {zzz}

# 8.4: the same holds with DQS turned on explicitly at run time, which is the
# setting the compile-time default cannot control
do_test 8.4.1 {
  sqlite3_db_config db DQS_DML 1
  sqlite3_db_config db DQS_DDL 1
  execsql {SELECT "nosuchcolumn"}
} {nosuchcolumn}
do_catchsql_test 8.4.2 {
  SELECT [nosuchcolumn]
} {1 {no such column: nosuchcolumn}}
do_execsql_test 8.4.3 {
  SELECT M'(nosuchcolumn)'
} {nosuchcolumn}

#-------------------------------------------------------------------------
# 5.*: Backward compatibility.
#
# The extension is meant to be conservative: text that parses today must
# still parse, and only a balanced M'(...)' may acquire a new meaning.

do_execsql_test 5.0 {
  CREATE TABLE M(x);
  INSERT INTO M VALUES(42);
}

# 5.1: M is still an ordinary identifier, including as a table name followed
# with no space by a quoted alias
do_test 5.1.1 { execsql {SELECT x FROM M} } {42}
do_test 5.1.2 { execsql {SELECT x FROM M'abc'} } {42}
do_test 5.1.3 { execsql {SELECT x FROM M 'abc'} } {42}

# 5.2: and as a column name, a function argument, and a keyword prefix
do_test 5.2.1 { execsql {SELECT M.x FROM M} } {42}
do_test 5.2.2 { execsql {SELECT count(M.x) FROM M} } {1}
do_test 5.2.3 {
  execsql {WITH c AS MATERIALIZED (SELECT 7 AS v) SELECT v FROM c}
} {7}

# 5.3: ordinary string literals are untouched
do_test 5.3.1 { execsql {SELECT '(abc)'} } {(abc)}
do_test 5.3.2 { execsql {SELECT 'M'} } {M}

# 5.4: the one case that does change meaning, recorded so the cost is
# explicit rather than discovered.  Before the extension this named table M
# with the alias (x); now it is a literal, which is not valid in that
# position.  It needs a table or column named M followed with no space by a
# quoted alias whose first character opens a matcher.
do_catchsql_test 5.4.1 {
  SELECT x FROM M'(nosuchtable2)'
} {1 {no such table: nosuchtable2}}

#-------------------------------------------------------------------------
# 9.*: Re-parsing.
#
# SQLite stores the text of views and triggers in the schema and parses it
# again on the next open, and ALTER TABLE rewrites that text in place. So the
# question is not whether a value is ever re-parsed, it is whether it comes
# back byte for byte when it is.

do_execsql_test 9.0 {
  CREATE TABLE t9(name);
  CREATE TABLE log9(v);
  INSERT INTO t9 VALUES('alice');
}

# 9.1: inside a trigger body, which is stored as text and re-parsed
do_test 9.1.1 {
  execsql {
    CREATE TRIGGER tr9 AFTER INSERT ON t9 BEGIN
      INSERT INTO log9 VALUES(M'(' OR '1'='1)');
    END;
    INSERT INTO t9 VALUES('bob');
    SELECT v FROM log9;
  }
} [list {' OR '1'='1}]
do_test 9.1.2 {
  db close
  sqlite3 db test.db
  execsql {
    DELETE FROM log9;
    INSERT INTO t9 VALUES('carol');
    SELECT v FROM log9;
  }
} [list {' OR '1'='1}]

# 9.2: ALTER TABLE RENAME rewrites the stored text of a view.  The table name
# must change and the value must not.
#
# The value holds double quotes on purpose. renameQuotefixExprCb() in alter.c
# rewrites double-quoted string literals to single-quoted ones, and it fires on
# TK_STRING carrying EP_DblQuoted. A matchertext literal never carries that
# flag, so the value is left alone.
do_execsql_test 9.2.1 {
  CREATE VIEW v9 AS SELECT name, M'("q" ; --)' AS tag FROM t9;
  SELECT DISTINCT tag FROM v9;
} {{"q" ; --}}
do_test 9.2.2 {
  execsql {ALTER TABLE t9 RENAME TO t9b}
  execsql {SELECT sql FROM sqlite_schema WHERE name='v9'}
} [list {CREATE VIEW v9 AS SELECT name, M'("q" ; --)' AS tag FROM "t9b"}]
do_execsql_test 9.2.3 {
  SELECT DISTINCT tag FROM v9;
} {{"q" ; --}}
do_test 9.2.4 {
  db close
  sqlite3 db test.db
  execsql {SELECT DISTINCT tag FROM v9}
} [list {"q" ; --}]

# 9.3: sqlite3_expanded_sql() re-serializes a statement.  A bound parameter is
# substituted; a matchertext literal is passed through unchanged, because it is
# not a parameter.
#
# The output is therefore only valid input to a parser that knows the literal.
# Given to a build without SQLITE_ENABLE_MATCHERTEXT it would re-lex as an
# identifier followed by a different string. That is a scope limit on any tool
# which captures expanded SQL and replays it, not a defect here.
do_test 9.3.1 {
  set stmt [sqlite3_prepare_v2 db {
    SELECT * FROM t9b WHERE name = M'(' OR '1'='1)' AND name = ?
  } -1 tail]
  sqlite3_bind_text $stmt 1 {b'c} 3
  set res [sqlite3_expanded_sql $stmt]
  sqlite3_finalize $stmt
  string match {*M'(' OR '1'='1)'*} $res
} 1
do_test 9.3.2 {
  set stmt [sqlite3_prepare_v2 db {SELECT ?, M'(x)'} -1 tail]
  sqlite3_bind_text $stmt 1 {y} 1
  set res [sqlite3_expanded_sql $stmt]
  sqlite3_finalize $stmt
  set res
} {SELECT 'y', M'(x)'}

#-------------------------------------------------------------------------
# 10.*: The write path, %m and %M.
#
# Both concern the content of one literal and nothing outside it, and they
# take opposite routes to containment:
#
#   %m  the whole content, encoded and wrapped as M'(...)'.  Encoding is
#       total, so this conversion never refuses a value.
#   %M  one untrusted piece of that content, verified and emitted verbatim.
#       This is the strict route: what cannot embed as it stands is refused,
#       mprintf returns NULL, and the test command reports "rejected".
#
# %M exists for a caller who writes matchers of its own around the piece and
# needs the piece to leave them alone; %m exists for the ordinary case, where
# a free-form value simply has to reach the hole.

# 10.1: %m wraps content that is already matchertext, quotes and all
foreach {tn val out} {
  1  {alice}                 {WHERE n = M'(alice)'}
  2  {' OR '1'='1}           {WHERE n = M'(' OR '1'='1)'}
  3  {x'; DROP TABLE t; --}  {WHERE n = M'(x'; DROP TABLE t; --)'}
  4  {f(x) [y] {z}}          {WHERE n = M'(f(x) [y] {z})'}
  5  {}                      {WHERE n = M'()'}
} {
  do_test 10.1.$tn { sqlite3_matchertext_printf {WHERE n = %m} $val } $out
}

# 10.2: content that could not embed verbatim is escaped, not refused.  Only
# the unmatched matchers change; everything else is left as it was.
foreach {tn val out} {
  1  {x) OR 1=1 --}  {WHERE n = M'(x\c() OR 1=1 --)'}
  2  {f(x}           {WHERE n = M'(f\o()x)'}
  3  {(a]}           {WHERE n = M'(\o()a\c[])'}
  4  {smile :]}      {WHERE n = M'(smile :\c[])'}
  5  {)(}            {WHERE n = M'(\c()\o())'}
} {
  do_test 10.2.$tn { sqlite3_matchertext_printf {WHERE n = %m} $val } $out
}

# 10.3: the caller's own text inside the literal is encoded on the same
# terms, so an unbalanced '[' in a message is escaped rather than fatal
do_test 10.3.1 {
  sqlite3_matchertext_printf {VALUES(%m)} {Hi user, x welcome !}
} {VALUES(M'(Hi user, x welcome !)')}
do_test 10.3.2 {
  sqlite3_matchertext_printf {VALUES(%m)} {Hi user, x welcome ![}
} {VALUES(M'(Hi user, x welcome !\o[])')}

# 10.4: nothing outside the literal is inspected.  An unbalanced matcher
# elsewhere in the statement is the caller's business: it cannot let a value
# escape its own hole.
do_test 10.4.1 {
  sqlite3_matchertext_printf {SELECT ')' FROM t WHERE n=%m} v
} {SELECT ')' FROM t WHERE n=M'(v)'}
do_test 10.4.2 {
  sqlite3_matchertext_printf {SELECT ( FROM t WHERE n=%m} v
} {SELECT ( FROM t WHERE n=M'(v)'}

# 10.5: %M, the strict conversion.  The caller wrote "Hi [" and "] bye"
# around the piece.  A piece carrying ']' would close the caller's '[' and so
# escape its slot, so it is refused rather than quietly rewritten.
do_test 10.5.1 { sqlite3_matchertext_printf {Hi [%M] bye} {x}   } {Hi [x] bye}
do_test 10.5.2 { sqlite3_matchertext_printf {Hi [%M] bye} {[a]} } {Hi [[a]] bye}
do_test 10.5.3 { sqlite3_matchertext_printf {Hi [%M] bye} {x]y} } {rejected}
do_test 10.5.4 {
  sqlite3_matchertext_printf {Hi %M bye} {' OR '1'='1}
} {Hi ' OR '1'='1 bye}

# %M emits exactly what it was given: no escaping, so a backslash stays one
# and the caller's matchers keep their partners
do_test 10.5.5 {
  sqlite3_matchertext_printf {Hi [%M] bye} "a\\b"
} "Hi \[a\\b\] bye"

# 10.6: the two together.  A %M piece is verbatim, so content assembled from
# %M pieces is still raw and %m encodes the result as a whole.
do_test 10.6.1 {
  sqlite3_matchertext_printf {VALUES(%m)} \
      [sqlite3_matchertext_printf {Hi user, %M welcome !} bob]
} {VALUES(M'(Hi user, bob welcome !)')}
do_test 10.6.2 {
  set content [sqlite3_matchertext_printf {Hi user, %M welcome ![} bob]
  list $content [sqlite3_matchertext_printf {VALUES(%m)} $content]
} {{Hi user, bob welcome ![} {VALUES(M'(Hi user, bob welcome !\o[])')}}

# 10.7: several holes
do_test 10.7.1 {
  sqlite3_matchertext_printf {WHERE a=%m AND b=%m} {p'q} {r(s)}
} {WHERE a=M'(p'q)' AND b=M'(r(s))'}
do_test 10.7.2 {
  sqlite3_matchertext_printf {WHERE a=%m AND b=%m} {p'q} {r)s}
} {WHERE a=M'(p'q)' AND b=M'(r\c()s)'}
# One bad piece still refuses the whole statement under the strict conversion
do_test 10.7.3 {
  sqlite3_matchertext_printf {WHERE a=[%M] AND b=[%M]} {x} {r)s}
} {rejected}

# 10.8: a NULL value is SQL NULL, as %Q does
do_test 10.8.1 { sqlite3_matchertext_printf {WHERE n = %m} } {WHERE n = NULL}

# 10.9: the other conversions are untouched
# The three escaping conversions are unchanged, and deliberately so.  Each
# doubles the delimiter its own context uses, which is correct only while the
# caller puts the result in that context.
do_test 10.9.1 {
  sqlite3_matchertext_printf {%q | %Q | %w} {a'b} {c'd} {e"f}
} {a''b | 'c''d' | e""f}

# The contrast with %m, and the reason they were left alone.  An unmatched
# matcher passes straight through all three: it is not a delimiter of theirs,
# so there is nothing for them to double.  Containment there rests entirely on
# the caller having chosen the conversion that matches the sink.
do_test 10.9.2 {
  sqlite3_matchertext_printf {%q | %Q | %w} {a]b} {c]d} {e]f}
} {a]b | 'c]d' | e]f}

# %m does not depend on that choice.  It escapes for the one discipline the
# sink reads, not for a context it was never told about.
do_test 10.9.3 {
  sqlite3_matchertext_printf {%m} {c]d}
} {M'(c\c[]d)'}

# 10.10: what %m produces parses, and the value stays data.  The last two
# cases could not embed verbatim, so they exercise the encoder end to end:
# what the reader recovers is the value the caller passed.
do_execsql_test 10.10.0 {
  CREATE TABLE t10(n);
  INSERT INTO t10 VALUES('alice'), ('bob');
}
foreach {tn val cnt} {
  1  {alice}                  1
  2  {' OR '1'='1}            0
  3  {x'; DROP TABLE t10; --} 0
  4  {p'q}                    0
  5  {smile :]}               0
  6  {x) OR 1=1 --}           0
} {
  do_test 10.10.$tn {
    execsql [sqlite3_matchertext_printf \
        {SELECT count(*) FROM t10 WHERE n = %m} $val]
  } $cnt
}
do_execsql_test 10.10.9 { SELECT count(*) FROM t10; } {2}

# 10.11: the round trip through %m is exact for any value at all.  The
# reader decodes, so the writer escapes backslashes too, which is what makes
# a value that already looks like an escape survive as itself.
foreach {tn val} {
  1  {a\b}
  2  {\o()}
  3  {smile :]}
  4  {printf("[")}
  5  {' OR '1'='1}
  6  {}
} {
  do_test 10.11.$tn {
    execsql [sqlite3_matchertext_printf {SELECT %m} $val]
  } [list $val]
}

# What that costs in the SQL text: the escaped spelling, which is longer
do_test 10.11.7 {
  sqlite3_matchertext_printf {%m} "a\\b"
} "M'(a\\\\b)'"

# 10.12: the public encoder and its inverse, the same routines %m uses,
# for a caller placing a value in a hole itself
do_test 10.12.1 { sqlite3_matchertext_encode {smile :]} } {smile :\c[]}
do_test 10.12.2 { sqlite3_matchertext_decode {smile :\c[]} } {smile :]}
do_test 10.12.3 { sqlite3_matchertext_verify [sqlite3_matchertext_encode {f(x}] } 1
do_test 10.12.4 {
  sqlite3_matchertext_decode [sqlite3_matchertext_encode {a\o()b}]
} {a\o()b}
do_test 10.12.5 { sqlite3_matchertext_encode {} } {}

#-------------------------------------------------------------------------
# 11.*: SQLITE_DBCONFIG_MATCHERTEXT.
#
# The setting imposes two rules on SQL arriving from outside:
#
#   1. no quote-delimited literal, the hole that string concatenation fills;
#   2. the text must itself be matchertext, checked whole and before any hole
#      boundary is located.
#
# Rule 2 is what makes rule 1 worth having.  Without it an application can
# still write the delimiters by hand and paste raw bytes between them, and a
# payload beginning ")'" closes the hole and continues in host syntax.  Such
# a payload leaves an unmatched matcher in the text, so rule 2 refuses it.
#
# What neither rule can reach is a payload that balances its own matchers,
# because nothing distinguishes it from a template the application meant to
# write; 11.8 records that boundary.  Premise A2 therefore still rests on the
# application routing values through %m, %M or a bound parameter.
#
# SQL that SQLite generates for itself is exempt: it is written in the C
# source, and it is what the schema writer emits through %Q.
#
# Off by default, so a connection behaves as SQLite always has until it asks
# for the tighter rule.

do_execsql_test 11.0 {
  CREATE TABLE t11(n);
  INSERT INTO t11 VALUES(M'(a)'), (M'(b)'), (M'(c)');
  -- Written while the setting is off, so its body holds an ordinary literal.
  -- Everything that re-parses this later has to keep accepting it.
  CREATE VIEW v11 AS SELECT 'lit' AS x;
}

# 11.1: off by default, a literal works as always
do_execsql_test 11.1.1 { SELECT count(*) FROM t11 WHERE n = 'a' } {1}

# 11.2: rule 1.  With the setting on, a quoted literal from outside is
# refused, so the hole that concatenation traditionally fills is unavailable
do_test 11.2.1 {
  sqlite3_db_config db MATCHERTEXT 1
  catchsql {SELECT count(*) FROM t11 WHERE n = 'a'}
} {1 {quoted string literal 'a': use a matchertext literal M'(...)'}}
do_test 11.2.2 {
  catchsql {SELECT count(*) FROM t11 WHERE n = 'x' OR '1'='1'}
} {1 {quoted string literal 'x': use a matchertext literal M'(...)'}}

# 11.3: the matchertext form is how a value is written instead
do_execsql_test 11.3.1 { SELECT count(*) FROM t11 WHERE n = M'(a)' } {1}
do_execsql_test 11.3.2 { SELECT count(*) FROM t11 WHERE n = M'(x' OR '1'='1)' } {0}

# 11.4: names too, since nm accepts the literal beside STRING
do_execsql_test 11.4.1 { SELECT count(*) FROM M'(t11)' } {3}

# 11.5: SQLite's own SQL still runs, which is what the exemption is for
do_execsql_test 11.5.1 {
  CREATE TABLE t11b(x);
  CREATE INDEX i11 ON t11b(x);
  DROP INDEX i11;
  DROP TABLE t11b;
  SELECT count(*) FROM t11;
} {3}
do_execsql_test 11.5.2 {
  ALTER TABLE t11 RENAME TO t11c;
  SELECT count(*) FROM M'(t11c)';
} {3}

# A view body written before the setting was turned on holds an ordinary
# literal, and every path that re-parses that stored text must still accept
# it.  Schema text was already accepted when it was written; re-reading it is
# not input arriving from outside.  ALTER TABLE RENAME re-parses it through
# PARSE_MODE_RENAME, which is why the exemption tests the parse mode and not
# just the database flags.
do_execsql_test 11.5.3 {
  SELECT x FROM v11;
} {lit}
do_execsql_test 11.5.4 {
  ALTER TABLE t11c RENAME TO t11d;
  ALTER TABLE t11d RENAME TO t11c;
  SELECT x FROM v11;
} {lit}

# VACUUM runs a script of its own full of ordinary literals
do_execsql_test 11.5.5 { VACUUM } {}

# and the schema re-parse at open, with the setting still on
do_test 11.5.6 {
  db close
  sqlite3 db test.db
  sqlite3_db_config db MATCHERTEXT 1
  execsql {SELECT x FROM v11}
} {lit}

# 11.6: and back off again
do_test 11.6.1 {
  sqlite3_db_config db MATCHERTEXT 0
  execsql {SELECT count(*) FROM t11c WHERE n = 'a'}
} {1}

#-------------------------------------------------------------------------
# 11.7: rule 2, the text must be matchertext.
#
# The application writes the delimiters itself and pastes an untrusted value
# between them, which is what rule 1 alone leaves open.  A payload that
# closes the hole and continues in host syntax has to emit the closer, and
# the closer it emits is unmatched, so the text is not matchertext.

do_test 11.7.0 {
  sqlite3_db_config db MATCHERTEXT 1
  execsql {SELECT count(*) FROM t11c}
} {3}

# The canonical breakout, hand-built hole and all
foreach {tn payload} {
  1  {)' OR 1=1 --}
  2  {)' OR 1=1 ; DROP TABLE t11c --}
  3  {)' UNION SELECT name FROM sqlite_schema --}
  4  {)'}
} {
  do_test 11.7.$tn {
    catchsql "SELECT count(*) FROM t11c WHERE n = M'($payload)'"
  } {1 {SQL is not matchertext: a matcher outside a hole is unmatched}}
}

# The rule is about the text, not about holes, so an unmatched matcher
# anywhere in SQL from outside is refused
do_test 11.7.5 {
  catchsql {SELECT count(*) FROM t11c WHERE n = M'(a)' AND (1=1}
} {1 {SQL is not matchertext: a matcher outside a hole is unmatched}}

# What the application writes through %m always passes, because the encoder's
# output is matchertext whatever the value was
foreach {tn payload cnt} {
  1  {)' OR 1=1 --}  0
  2  {smile :]}      0
  3  {a}             1
} {
  do_test 11.7.6.$tn {
    execsql [sqlite3_matchertext_printf \
        {SELECT count(*) FROM t11c WHERE n = %m} $payload]
  } $cnt
}

# 11.8: the boundary.  A payload that balances its own matchers is refused by
# neither rule: it opens a hole of its own so the trailing delimiter closes
# it, and the result is a well-formed statement with two empty holes.  No
# lexical rule separates that from a template the application meant to write,
# which is why premise A2 belongs to the application and not to the database.
do_test 11.8.1 {
  execsql "SELECT count(*) FROM t11c WHERE n = M'()' OR 1=1 OR n = M'()'"
} {3}
do_test 11.8.2 {
  set payload {)' OR 1=1 OR n = M'(}
  list [sqlite3_matchertext_verify \
            "SELECT count(*) FROM t11c WHERE n = M'($payload)'"] \
       [execsql "SELECT count(*) FROM t11c WHERE n = M'($payload)'"]
} {1 3}
# Routed through %m instead, the same payload is inert
do_test 11.8.3 {
  execsql [sqlite3_matchertext_printf \
      {SELECT count(*) FROM t11c WHERE n = %m} {)' OR 1=1 OR n = M'(}]
} {0}

# 11.9: the rule reaches both holes, and reaches a statement carrying no
# hole at all, since it is a property of the text rather than of a hole.
#
# Each case opens its own connection so that the statement under test is the
# first one parsed there.  That matters: the mode is read from the header at
# schema load, which for a cold connection happens only after the parse, so
# a check made solely during tokenizing would miss exactly these.
do_test 11.9.0 {
  db close
  forcedelete test119.db
  sqlite3 db test119.db
  execsql {
    PRAGMA matchertext=1;
    CREATE TABLE u(name);
    INSERT INTO u VALUES(M'(alice)'), (M'(bob)');
  }
  db close
  set res [list]
  foreach {tn sql} {
    name    {SELECT count(*) FROM [u] WHERE 1=1 --]}
    value   {SELECT count(*) FROM u WHERE name = M'()' OR 1=1 --)'}
    nohole  {SELECT count(*) FROM u WHERE 1=1 --)}
    opener  {SELECT count(*) FROM u WHERE name = M'(a)' AND (1=1}
  } {
    sqlite3 cold test119.db
    lappend res $tn [catch {cold eval $sql}]
    cold close
  }
  set res
} {name 1 value 1 nohole 1 opener 1}

# The same connections accept the legitimate spelling of each
do_test 11.9.1 {
  set res [list]
  foreach {tn sql} {
    name   {SELECT count(*) FROM [u]}
    value  {SELECT count(*) FROM u WHERE name = M'(alice)'}
    plain  {SELECT count(*) FROM u}
  } {
    sqlite3 cold test119.db
    lappend res $tn [cold eval $sql]
    cold close
  }
  set res
} {name 2 value 1 plain 2}

# 11.9.2: a bound parameter is not text, so the rule does not touch it and a
# value that is not matchertext still binds, encoded on the way in
do_test 11.9.2 {
  sqlite3 db test119.db
  set stmt [sqlite3_prepare_v2 db {SELECT count(*) FROM u WHERE name = ?} -1 tail]
  sqlite3_bind_text $stmt 1 {smile :]} 8
  sqlite3_step $stmt
  set n [sqlite3_column_text $stmt 0]
  sqlite3_finalize $stmt
  set n
} {0}

do_test 11.9.9 {
  db close
  sqlite3 db test.db
  sqlite3_db_config db MATCHERTEXT 0
  set x 1
} {1}

#-------------------------------------------------------------------------
# 12.*: Strict mode closes the DQS fallback.
#
# The quoted value hole exists in two spellings.  Section 11 shows the
# single-quoted one refused; DQS is the double-quoted one, where "x" becomes
# a string when it fails to resolve as a name.  Strict mode masks that
# fallback, so under it a double-quoted token is a name only, exactly the
# behavior DQS_DML=0 already gives.

do_execsql_test 12.0 {
  CREATE TABLE t12(a);
  INSERT INTO t12 VALUES('zzz');
}

# Established by 8.1: with strict mode off, the misfeature is on.  The
# error is the one DQS_DML=0 produces, hint and all.
do_test 12.1.1 {
  sqlite3_db_config db MATCHERTEXT 1
  catchsql {SELECT "nosuchcol12"}
} {1 {no such column: "nosuchcol12" - should this be a string literal in single-quotes?}}

# A double-quoted token that does resolve is a name, and still works
do_execsql_test 12.1.2 { SELECT "a" FROM t12 } {zzz}

# And the mask lifts with the flag
do_test 12.2.1 {
  sqlite3_db_config db MATCHERTEXT 0
  execsql {SELECT "nosuchcol12"}
} {nosuchcol12}

#-------------------------------------------------------------------------
# 13.*: PRAGMA matchertext, the database as the authority.
#
# The strict mode of section 11 was a connection setting.  The pragma writes
# the mode into the database header instead, where every connection that
# opens the file inherits it and none can opt out: the database, not the
# connection, decides how it is spoken to.
#
# Under a strict database, text at rest lives in the encoded domain.  A
# bound value is canonically encoded on its way in, never refused; the API
# boundary decodes on the way out; and a literal is canonicalized at parse.
# One representation at rest is what makes a literal-written value and a
# bound value compare equal.

do_test 13.0.1 {
  db close
  forcedelete test13.db
  sqlite3 db test13.db
  execsql {
    PRAGMA matchertext=1;
    CREATE TABLE t13(v TEXT);
  }
  execsql {PRAGMA matchertext}
} {1}

# 13.1: strict immediately on the connection that set it
do_catchsql_test 13.1.1 {
  SELECT 'raw'
} {1 {quoted string literal 'raw': use a matchertext literal M'(...)'}}

# 13.2: a fresh connection inherits the mode from the file before its first
# statement, with no db_config anywhere in sight
do_test 13.2.1 {
  db close
  sqlite3 db test13.db
  catchsql {SELECT 'raw'}
} {1 {quoted string literal 'raw': use a matchertext literal M'(...)'}}

# 13.3: the connection cannot opt out while the header says on.  The
# db_config call reports the mode still in force.
do_test 13.3.1 {
  sqlite3_db_config db MATCHERTEXT 0
} {1}
do_catchsql_test 13.3.2 {
  SELECT 'raw'
} {1 {quoted string literal 'raw': use a matchertext literal M'(...)'}}

# 13.4: binding is total.  A value VERIFY refuses is encoded, not rejected,
# and the API decodes on the way out, so the round trip is exact.
do_test 13.4.1 {
  execsql {INSERT INTO t13 VALUES(M'(alice)')}
  set stmt [sqlite3_prepare_v2 db {INSERT INTO t13 VALUES(?)} -1 tail]
  sqlite3_bind_text $stmt 1 {smile :]} 8
  sqlite3_step $stmt
  sqlite3_finalize $stmt
  execsql {SELECT v FROM t13 WHERE v LIKE M'(smile%)'}
} [list {smile :]}]

# What sits at rest is the encoded form, and SQL functions see that domain:
# length() counts the bytes of smile :\c[].
do_execsql_test 13.4.2 {
  SELECT length(v) FROM t13 WHERE v LIKE M'(smile%)'
} {11}

# 13.5: a literal spelling the same value compares equal to the bound one,
# because both are canonical at rest
do_execsql_test 13.5.1 {
  SELECT count(*) FROM t13 WHERE v = M'(smile :\c[])'
} {1}

# Canonicalization at parse: a hand-written lone backslash and a bound
# backslash meet at the same bytes
do_test 13.5.2 {
  set stmt [sqlite3_prepare_v2 db {INSERT INTO t13 VALUES(?)} -1 tail]
  sqlite3_bind_text $stmt 1 "\\" 1
  sqlite3_step $stmt
  sqlite3_finalize $stmt
  execsql {SELECT count(*) FROM t13 WHERE v = M'(\)'}
} {1}

# 13.6: the file is the authority for turning off as well
do_test 13.6.1 {
  execsql {PRAGMA matchertext=0}
  execsql {SELECT 'raw'}
} {raw}

#-------------------------------------------------------------------------
# 14.*: sqlite3_complete().
#
# The shell decides where one statement ends with its own scanner, separate
# from the tokenizer.  It has to end both holes the same way, or a value
# carrying a semicolon would split a statement that the parser reads whole.

ifcapable !complete {
  finish_test
  return
}

# 14.1: a matchertext literal is one token, so what it carries does not end
# the statement.  Each of these is a single complete statement.
foreach {tn sql} {
  1  {SELECT M'(;)';}
  2  {SELECT M'(it's)';}
  3  {SELECT M'(a;b)' , M'(c;d)';}
  4  {SELECT M'(--)';}
  5  {SELECT M'(/* x */)';}
  6  {SELECT M'((a;b))';}
  7  {SELECT m'(;)';}
} {
  do_test 14.1.$tn { db complete $sql } {1}
}

# 14.2: and the same text without the trailing semicolon is not complete
foreach {tn sql} {
  1  {SELECT M'(;)'}
  2  {SELECT M'(it's)'}
} {
  do_test 14.2.$tn { db complete $sql } {0}
}

# 14.3: an unterminated literal leaves the statement open, whatever it
# carries.  The shell keeps reading rather than sending a broken statement.
foreach {tn sql} {
  1  {SELECT M'(}
  2  {SELECT M'(a;}
  3  {SELECT M'(a;)}
  4  {SELECT M'(unbalanced ; }
} {
  do_test 14.3.$tn { db complete $sql } {0}
}

# 14.4: the name hole ends by balance too, so a nested bracket does not end
# the name early and a semicolon inside one is not a separator
do_test 14.4.1 { db complete {SELECT * FROM [a[b]c];} } {1}
do_test 14.4.2 { db complete {SELECT * FROM [a;b];} } {1}
do_test 14.4.3 { db complete {SELECT * FROM [a[b]c]} } {0}
do_test 14.4.4 { db complete {SELECT * FROM [a[b} } {0}
# The sharpest case: ending the name at the first ']' would leave the ';'
# outside it and split the statement in the middle of a name.
do_test 14.4.5 { db complete {SELECT * FROM [a[b]c;d]} } {0}
do_test 14.4.6 { db complete {SELECT * FROM [a[b]c;d];} } {1}

# 14.5: an ill-formed literal is not a literal.  M lexes as an identifier
# and the quote that follows opens an ordinary string, which is exactly what
# the tokenizer does with the same text.
do_test 14.5.1 { db complete {SELECT M'abc';} } {1}
do_test 14.5.2 { db complete {SELECT M 'abc';} } {1}
do_test 14.5.3 { db complete {SELECT M'(a]b)';} } {1}

# 14.6: text that has always parsed is unaffected
foreach {tn sql res} {
  1  {SELECT 1;}              1
  2  {SELECT 'a;b';}          1
  3  {SELECT 1}               0
  4  {SELECT "a;b";}          1
  5  {SELECT [ident];}        1
  6  {CREATE TABLE t(x);}     1
  7  {SELECT '}               0
} {
  do_test 14.6.$tn { db complete $sql } $res
}

#-------------------------------------------------------------------------
# 15.*: The corpus experiment, pinned.
#
# pipeline/sqli_experiment.py places every recorded SQL attack payload into a
# real statement and compares the compiled bytecode against the same statement
# holding a benign value. This layer keeps a few of its cases here, so a
# regression is caught by "make matchertext" rather than only by a run that
# needs data/cve.db.
#
# Two gaps in 4.5 are what these cover. It pastes the payload into M'(...)' by
# hand, so it can only use payloads that already balance; and it never composes
# %m with the skeleton comparison, although %m is the conversion that exists
# precisely to carry a value that does not balance.

do_execsql_test 15.0 {
  CREATE TABLE t15(name TEXT, id INTEGER);
  INSERT INTO t15 VALUES('alice',1),('bob',2);
}

# mt_m_skeleton is 4.5's comparison with the literal written by %m rather than
# by hand, so an unbalanced payload can be tested at all.
proc mt_m_skeleton {sql payload} {
  set out [list]
  foreach {addr opcode p1 p2 p3 p4 p5 comment} \
      [execsql [sqlite3_matchertext_printf $sql $payload]] {
    lappend out $addr $opcode $p1 $p2 $p3 $p5
  }
  return $out
}

set mt15_hosts {
  select   {EXPLAIN SELECT id FROM t15 WHERE name = %m}
  insert   {EXPLAIN INSERT INTO t15(name) VALUES(%m)}
  like     {EXPLAIN SELECT id FROM t15 WHERE name LIKE %m}
  ordering {EXPLAIN SELECT %m AS c FROM t15 ORDER BY 1}
}

# 15.1: values 4.5 cannot express, because none of them balances.  Every one
# reaches the parser through %m, which escapes the unmatched matchers.
set mt15_unbalanced {
  1  {x) OR 1=1 --}
  2  {smile :]}
  3  {)(}
  4  {(a]}
  5  {)' OR 1=1 --}
  6  {]}
  7  {f(x}
}
foreach {host sql} $mt15_hosts {
  set mt15_base [mt_m_skeleton $sql {alice}]
  foreach {tn payload} $mt15_unbalanced {
    do_test 15.1.$host.$tn { mt_m_skeleton $sql $payload } $mt15_base
  }
}

# 15.2: strings taken from the corpus itself, each one a payload that does
# break out of a quoted slot when it is concatenated (see 15.4).
set mt15_corpus {
  1  {admin' --}
  2  {' or 1/*}
  3  {'OR 1=1--}
  4  {root' --}
  5  {' or ''='}
}
foreach {host sql} $mt15_hosts {
  set mt15_base [mt_m_skeleton $sql {alice}]
  foreach {tn payload} $mt15_corpus {
    do_test 15.2.$host.$tn { mt_m_skeleton $sql $payload } $mt15_base
  }
}

# 15.3: the value survives the round trip whatever it held
foreach {tn payload} [concat $mt15_unbalanced $mt15_corpus] {
  do_test 15.3.$tn {
    execsql [sqlite3_matchertext_printf {SELECT %m} $payload]
  } [list $payload]
}

# 15.4: the same payloads against a quoted slot built by concatenation, which
# is what the corpus was written to attack.  These must NOT be inert: a suite
# where nothing breaks out is not evidence of containment, only of a test that
# cannot see one.  15.4.1 counts 2 of 2 rows, so the WHERE clause was defeated.
do_test 15.4.1 {
  execsql "SELECT count(*) FROM t15 WHERE name = '[set p {' or ''='}]'"
} {2}
do_test 15.4.2 {
  execsql "SELECT count(*) FROM t15 WHERE name = '[set p {' OR 1=1 --}]'"
} {2}
# and the matchertext form of the same statement selects nothing
do_test 15.4.3 {
  execsql [sqlite3_matchertext_printf \
      {SELECT count(*) FROM t15 WHERE name = %m} {' or ''='}]
} {0}

# 15.5: premise A2, that the value must go through the hole rather than into
# it.  A caller that builds M'(' and ')' itself and concatenates is outside the
# discipline, and the value escapes exactly as it would from a quote.  Recorded
# here so the cost of hand-building a hole stays visible.
do_test 15.5.1 {
  execsql "SELECT count(*) FROM t15 WHERE name = M'([set p {)' OR 1=1 --}])'"
} {2}
# %m closes it, because the encoder escapes the unmatched closer
do_test 15.5.2 {
  execsql [sqlite3_matchertext_printf \
      {SELECT count(*) FROM t15 WHERE name = %m} {)' OR 1=1 --}]
} {0}
# and %M refuses it outright rather than rewriting it
do_test 15.5.3 {
  sqlite3_matchertext_printf {WHERE name = M'(%M)'} {)' OR 1=1 --}
} {rejected}

# 15.6: the name hole, where a bound parameter cannot go.  Encoding is the
# caller's job here, since no % conversion writes a bracketed name.
do_execsql_test 15.6.0 {
  CREATE TABLE t15b([id] INTEGER, [odd name] TEXT);
  INSERT INTO t15b VALUES(1,'x');
}
# A hand-built name hole lets the value out: the statement was written to read
# t15b and reads the schema instead.
do_test 15.6.1 {
  set p {name] FROM sqlite_schema --[}
  expr {[lsearch [execsql "SELECT \[$p\] FROM t15b"] t15b]>=0}
} {1}
# Encoded, the whole value is one name. Naming no column is an error, and the
# error repeats the value back in full, which is what says no part of it was
# read as syntax.
do_test 15.6.2 {
  set enc [sqlite3_matchertext_encode {name] FROM sqlite_schema --[}]
  catchsql "SELECT \[$enc\] FROM t15b"
} {1 {no such column: name] FROM sqlite_schema --[}}
do_test 15.6.3 {
  set enc [sqlite3_matchertext_encode {odd name}]
  execsql "SELECT \[$enc\] FROM t15b"
} {x}

finish_test
